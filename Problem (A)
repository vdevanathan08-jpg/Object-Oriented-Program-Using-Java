class Exhibit {
    String name, era;

    Exhibit(String name, String era) {
        this.name = name;
        this.era = era;
    }

    void display() {
        System.out.println("Exhibit: " + name);
        System.out.println("Era: " + era);
    }
}

class InteractiveExhibit extends Exhibit {
    boolean touchEnabled;

    InteractiveExhibit(String name, String era, boolean touchEnabled) {
        super(name, era);
        this.touchEnabled = touchEnabled;
    }

    @Override
    void display() {
        System.out.println("===== Museum Exhibit =====");
        System.out.println("Name: " + name);
        System.out.println("Era: " + era);
        System.out.println("Touch Enabled: " + touchEnabled);
    }

    public static void main(String[] args) {
        InteractiveExhibit exhibit =
            new InteractiveExhibit("Dinosaur Fossil", "Jurassic", true);

        exhibit.display();
    }
}
